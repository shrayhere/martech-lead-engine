# ==============================================================================
# MarTech Data Quality & Lead Scoring Engine - Environment Variables
# ==============================================================================

# --- Security & Authentication (Required for Production) ---
# The master password required to log in to the UI and access API routes
APP_PASSWORD=martech2026

# Secret key used for signing JWT session tokens (set a secure random string in production)
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string-in-production

# --- Database Configuration ---
# Leave unset or empty for local development SQLite (sqlite:///./martech.db)
# For production (Neon / Render), set your PostgreSQL connection URI:
# DATABASE_URL=postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///./martech.db

# --- HubSpot CRM Integration ---
# Private App access token for pulling workflows and syncing scored leads
# HUBSPOT_ACCESS_TOKEN=pat-na2-xxxx-xxxx-xxxx-xxxx

# Client Secret used to verify incoming webhook signatures (X-HubSpot-Signature-v3)
# HUBSPOT_CLIENT_SECRET=your_hubspot_app_client_secret

# Automatic sync interval in hours (default: 1)
HUBSPOT_SYNC_INTERVAL_HOURS=1

# --- Optional AI Classification ---
# Anthropic API key for Claude-powered lead title classification
# ANTHROPIC_API_KEY=sk-ant-api03-...

# --- CORS Settings ---
# Comma-separated allowed origins for frontend communication
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173
