# Copy to .env and adjust.

# Flask
FLASK_APP=run.py
SECRET_KEY=replace-with-a-long-random-string
FLASK_DEBUG=0

# Database — MySQL 8+ (recommended / production):
# DATABASE_URL=mysql+pymysql://martech_user:change-me@127.0.0.1:3306/martech?charset=utf8mb4
# Leave DATABASE_URL unset to use the local SQLite file instance/martech.db (development fallback).
DATABASE_URL=

# Separate database for automated tests (defaults to in-memory SQLite):
# TEST_DATABASE_URL=mysql+pymysql://martech_user:change-me@127.0.0.1:3306/martech_test?charset=utf8mb4

# Uploads
MAX_UPLOAD_MB=10
MAX_IMPORT_ROWS=100000
CSV_CHUNK_SIZE=1000
# UPLOAD_FOLDER=uploads

# Phone numbers with 10 digits and no country code get this prefix during cleaning.
DEFAULT_COUNTRY_CODE=+1

# Set to 1 when serving over HTTPS.
SESSION_COOKIE_SECURE=0
